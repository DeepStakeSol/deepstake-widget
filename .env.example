# Copy to .env. Development Compose uses localhost; for production set the public HTTPS API URL.
# Example production pairing: VITE_BACKEND_URL=https://your-domain.example/api,
# DISABLE_BACKEND_PREFIX=true, IMAGE_URL_PREFIX=https://your-domain.example/api,
# and VITE_TELEMETRY_ENDPOINT=https://deepstake.info/api/telemetry.
VITE_BACKEND_URL=http://localhost:3000
DISABLE_BACKEND_PREFIX=false
IMAGE_URL_PREFIX=
VITE_TELEMETRY_ENDPOINT=http://localhost:3000/api/telemetry
# Empty uses frontend/package.json (1.1.0) in the built widget.
VITE_WIDGET_VERSION=

# Compose backend settings. Redis defaults to redis://redis:6379 when empty.
REDIS_URL=
TELEMETRY_OWN_HOSTS=deepstake.info
# Production requires two different non-empty private bearer tokens; never commit their values.
METRICS_BEARER_TOKEN=
TELEMETRY_STATS_TOKEN=
