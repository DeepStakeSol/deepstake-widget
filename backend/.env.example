# Copy to backend/.env. Production Compose reads this file for backend RPC and validator settings.
# Replace the RPC placeholders with endpoints for the networks you serve.
MAINNET_RPC_ENDPOINT=https://your-mainnet-rpc.example
DEVNET_RPC_ENDPOINT=https://your-devnet-rpc.example
# Optional when testnet is enabled.
TESTNET_RPC_ENDPOINT=
# Backend helper defaults; widget embeds resolve network independently.
NEXT_PUBLIC_NETWORK_ENV=mainnet
NEXT_PUBLIC_VALIDATOR_ADDRESS=YOUR_VALIDATOR_VOTE_ACCOUNT
# Optional Validators.app provider token.
VALIDATORS_APP_TOKEN=

# Direct backend runs can set these here. Production Compose overrides them from root .env.
REDIS_URL=redis://localhost:6379
METRICS_BEARER_TOKEN=
TELEMETRY_STATS_TOKEN=
TELEMETRY_OWN_HOSTS=deepstake.info
# Production Compose supplies these paths and NODE_ENV automatically.
SHARED_FILES_DIR=../shared
IMAGES_DIR=../images
