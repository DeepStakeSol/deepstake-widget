# Optional local Vite settings. Production Compose supplies the URL, prefix, images,
# telemetry endpoint, and version from the root .env at build time.
VITE_BACKEND_URL=http://localhost:3000
DISABLE_BACKEND_PREFIX=false
IMAGE_URL_PREFIX=
VITE_TELEMETRY_ENDPOINT=http://localhost:3000/api/telemetry
# Empty uses frontend/package.json.
VITE_WIDGET_VERSION=
# Optional bundle-wide network fallback; omitted means mainnet. data-options.network wins.
VITE_NEXT_PUBLIC_NETWORK_ENV=

# Optional protocol overrides. The widget has no RPC endpoint of its own: every
# transaction is relayed by the backend, so never put an RPC URL in this file.
VITE_VAULT_TX_URL=
VITE_VAULT_USE_EXTERNAL_API=
